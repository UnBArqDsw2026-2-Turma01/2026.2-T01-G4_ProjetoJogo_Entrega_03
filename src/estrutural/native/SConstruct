#!/usr/bin/env python
# Build da GDExtension "alquimia" (padrão Facade do sistema de alquimia).
# Uso, de dentro de native/:
#   py -m SCons platform=windows target=template_debug
#   py -m SCons platform=windows target=template_release
#   py -m SCons platform=web target=template_release threads=no   (requer Emscripten)
# Feche o editor do Godot antes: a DLL carregada fica travada no Windows.

env = SConscript("godot-cpp/SConstruct", {"api_version": "4.7"})

env.Append(CPPPATH=["src/"])

# Objetos vão para build/ (ignorada pelo Godot) e src/ fica limpa e visível no editor.
VariantDir("build", "src", duplicate=False)
sources = Glob("build/*.cpp") + Glob("build/jogo/*.cpp")

library = env.SharedLibrary(
    "../bin/alquimia{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)

Default(library)
