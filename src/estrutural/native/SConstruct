#!/usr/bin/env python

env = SConscript("godot-cpp/SConstruct", {"api_version": "4.7"})

env.Append(CPPPATH=["src/", "../decorator/"])

# Objetos vão para build/ (ignorada pelo Godot) e src/ fica limpa e visível no editor.
VariantDir("build", "src", duplicate=False)
sources = Glob("build/*.cpp") + Glob("build/jogo/*.cpp")

library = env.SharedLibrary(
    "../bin/alquimia{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)

Default(library)
