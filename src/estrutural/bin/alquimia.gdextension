[configuration]

entry_symbol = "alquimia_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://bin/libalquimia.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libalquimia.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/alquimia.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/alquimia.windows.template_release.x86_64.dll"
web.debug.wasm32 = "res://bin/alquimia.web.template_debug.wasm32.nothreads.wasm"
web.release.wasm32 = "res://bin/alquimia.web.template_release.wasm32.nothreads.wasm"
