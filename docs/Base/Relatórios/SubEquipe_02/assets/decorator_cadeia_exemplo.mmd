    style C fill:#f3e5f5,stroke:#8e24aa,stroke-width:2px
    style Q1 fill:#fffde7,stroke:#c9a400,stroke-width:1.5px
    style Q2 fill:#fffde7,stroke:#c9a400,stroke-width:1.5px
    style R fill:#fffde7,stroke:#c9a400,stroke-width:1.5px
    style V fill:#fffde7,stroke:#c9a400,stroke-width:1.5px
    style B fill:#e8f5e9,stroke:#43a047,stroke-width:2px
