Y=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="tj" target="ti"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="executarTurnoInimigo() [else] / avancarTurno()" style="edgeStyle=none;html=1;rounded=0;endArrow=open;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="ti" target="tj"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="executarTurnoJogador(c)&lt;br&gt;[inimigo derrotado]" style="edgeStyle=none;html=1;rounded=0;endArrow=open;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tj" target="vit"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="executarTurnoJogador(c)&lt;br&gt;[jogador derrotado pela explosão]" style="edgeStyle=none;html=1;rounded=0;endArrow=open;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tj" target="der"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="executarTurnoInimigo()&lt;br&gt;[jogador derrotado]" style="edgeStyle=none;html=1;rounded=0;endArrow=open;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ti" target="der"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=open;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="vit" target="fim_vit"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=open;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="der" target="fim_der"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="nota_estados" value="Cada estado é uma classe ConcreteState do padrão State.&lt;br&gt;Transição interna (dentro do estado): a requisição chega, gera só um aviso e o estado não muda.&lt;br&gt;[else]: vale quando as outras guardas do mesmo evento são falsas." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry y="560" width="500" height="70" as="geometry" x="420" /></mxCell></root></mxGraphModel></diagram></mxfile>